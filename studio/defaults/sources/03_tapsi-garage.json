{
  "key": "tapsi-garage",
  "name": "تپسی گاراژ",
  "domains": [
    "tapsi-garage.ir"
  ],
  "notes": "صفحه‌ی دسته‌بندی با اسکرول کامل می‌شود. مسیر دقیق فیلدها را در «آزمایش زنده» تنظیم کنید.",
  "sample_category_url": "https://tapsi-garage.ir/city/tehran/category/1/%D8%B1%D9%88%D8%BA%D9%86-%D9%88-%D8%B1%D9%88%D8%A7%D9%86-%DA%A9%D8%A7%D8%B1",
  "sample_product_url": "https://tapsi-garage.ir/city/tehran/category/1/%D8%B1%D9%88%D8%BA%D9%86-%D9%88-%D8%B1%D9%88%D8%A7%D9%86-%DA%A9%D8%A7%D8%B1/product/af64c235-ae38-45ba-918a-171c2a81f9a1/%D9%BE%DA%A9-%D8%B1%D9%88%D8%BA%D9%86-%D9%BE%D8%B1%D8%A7%DB%8C%D8%AF-%DA%A9%D8%A7%D8%B3%D9%BE%DB%8C%D9%86-%DA%AF%D9%84%D8%A7%DB%8C%D8%AF-sgcd-20w50-4l--%D9%81%DB%8C%D9%84%D8%AA%D8%B1-%D8%B1%D9%88%D8%BA%D9%86-%D9%88-%D9%81%DB%8C%D9%84%D8%AA%D8%B1-%D9%87%D9%88%D8%A7",
  "product_id_pattern": "/product/([0-9a-fA-F\\-]{36})",
  "listing": {
    "mode": "browser",
    "link_pattern": "/product/[0-9a-fA-F\\-]{36}",
    "pagination": {
      "type": "scroll",
      "idle_rounds": 4,
      "pause_ms": 1500,
      "max_rounds": 400
    }
  },
  "product": {
    "mode": "browser",
    "capture_xhr": [
      "*"
    ],
    "auto_expand": true,
    "scroll": true,
    "scroll_times": 6
  },
  "request": {
    "headers": {},
    "timeout_s": 45
  },
  "max_gallery": 12,
  "fields": [
    {
      "key": "title",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "name"
        },
        {
          "type": "css",
          "selector": "h1",
          "attr": "text"
        },
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "title_en",
      "strategies": [
        {
          "type": "spec",
          "names": [
            "نام انگلیسی",
            "English name"
          ]
        }
      ]
    },
    {
      "key": "brand",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "brand.name"
        },
        {
          "type": "spec",
          "names": [
            "برند",
            "نام تجاری",
            "سازنده"
          ]
        },
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "category",
      "strategies": [
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "breadcrumb",
      "strategies": [
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "short_description",
      "strategies": [
        {
          "type": "meta",
          "name": "description"
        },
        {
          "type": "meta",
          "name": "og:description"
        }
      ]
    },
    {
      "key": "long_description",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "description"
        },
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "specifications",
      "strategies": [
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "featured_image",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "image[0]"
        },
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "image"
        },
        {
          "type": "meta",
          "name": "og:image"
        },
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "gallery",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "image"
        },
        {
          "type": "auto"
        }
      ]
    },
    {
      "key": "price",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "offers.price"
        },
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "offers.lowPrice"
        }
      ]
    },
    {
      "key": "sku",
      "strategies": [
        {
          "type": "jsonld",
          "at_type": "Product",
          "path": "sku"
        }
      ]
    }
  ]
}